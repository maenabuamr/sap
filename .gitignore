# =========================================================================
# SECURITY-SENSITIVE: must NEVER be committed
# =========================================================================

# User credentials — even hashed, these belong in a secret store, not git.
data/users.json
data/users.json.bak
data/users.json.bak.*

# Generic secrets
.env
.env.*
*.pem
*.key
secrets.*
credentials.*

# =========================================================================
# PROJECT-SPECIFIC: cleanup of accidental commits from earlier work
# =========================================================================

# The committed zip of the project itself
sap-*.zip

# CSVs and Excel files in data/ — this repo treats them as confidential
# business data, not generic sample assets. Move them to a private bucket
# or a separate data repo. If you want to share *sample* data, copy it to
# data/sample/ and explicitly commit that subset only.
data/*.csv
data/*.xlsx
data/*.xls
data/*.parquet
data/*.feather

# Backups and temp files
*.bak
*.tmp
*.orig

# Large/restricted files
*.zip
fonts/AmiriQuran*.ttf

# Playwright cache
.cache/
.ms-playwright/
playwright/

# Playwright cache
.cache/
.ms-playwright/
playwright/
